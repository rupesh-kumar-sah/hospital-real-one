# ==========================================
# MediCare HMS - Environment Configuration
# ==========================================

# Application Environment (development / production)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://medicare-hms-backend.onrender.com
FRONTEND_URL=https://medicare-hms.vercel.app
ADMIN_PATH=mgmt-x7k2p
ADMIN_ALLOWED_IPS=
STAFF_ALLOWED_IPS=
TRUSTED_PROXY_IPS=

# Generate both values with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_ENCRYPTION_KEY=replace_with_a_random_64_character_secret
JWT_SECRET=replace_with_a_different_random_64_character_secret

# Database Driver Configuration
# Set DATABASE_URL on Render to the rotated Neon PostgreSQL connection string.
DATABASE_URL=
DB_DRIVER=pgsql

# Optional MySQL connection details (only when DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medicare_hms
DB_USER=replace_me
DB_PASS=replace_me

# MySQL Transport Encryption (SSL/TLS)
DB_SSL=false
DB_SSL_CA=

# SQLite Fallback Path (Used if DB_DRIVER=sqlite)
DB_PATH=./data/hms.db

# Encrypted local/cloud backup
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Store this only in .env or the machine's secret manager; never commit it.
BACKUP_ENCRYPTION_KEY=replace_with_a_random_64_character_hex_secret
BACKUP_DIRECTORY=E:/HM DATA/cloud-backups

# Automatic CSV/HTML export destination. Point this at a private
# Google Drive or OneDrive folder to sync the generated files automatically.
EXPORT_DIRECTORY=E:/HM DATA
