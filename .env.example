# ==========================================
# MediCare HMS - Environment Configuration
# ==========================================

# Application Environment (development / production)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://medicare-hms.onrender.com

# Master AES-256 Encryption Key for E2EE Data Security
APP_ENCRYPTION_KEY=medicare_hms_e2ee_secret_key_2026_laptop_secured_change_me!

# Database Driver Configuration
# Options: mysql (for Render cloud backend connecting to laptop MySQL) or sqlite (local standalone)
DB_DRIVER=mysql

# Laptop MySQL Connection Details (via Cloudflare Tunnel / Ngrok or Local IP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medicare_hms
DB_USER=hms_user
DB_PASS=laptop_mysql_secure_password_123

# MySQL Transport Encryption (SSL/TLS)
DB_SSL=false
DB_SSL_CA=

# SQLite Fallback Path (Used if DB_DRIVER=sqlite)
DB_PATH="E:\HM DATA\hms.db"
