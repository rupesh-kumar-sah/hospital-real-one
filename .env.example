# ==========================================
# MediCare HMS - Environment Configuration
# ==========================================

# Application Environment (development / production)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://medicare-hms-backend.onrender.com
FRONTEND_URL=https://medicare-hms.vercel.app

# Generate both values with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_ENCRYPTION_KEY=replace_with_a_random_64_character_secret
JWT_SECRET=replace_with_a_different_random_64_character_secret

# Database Driver Configuration
# Options: mysql (for Render cloud backend connecting to laptop MySQL) or sqlite (local standalone)
DB_DRIVER=mysql

# Optional MySQL connection details (only when DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medicare_hms
DB_USER=replace_me
DB_PASS=replace_me

# MySQL Transport Encryption (SSL/TLS)
DB_SSL=false
DB_SSL_CA=

# SQLite Fallback Path (Used if DB_DRIVER=sqlite)
DB_PATH=./data/hms.db
