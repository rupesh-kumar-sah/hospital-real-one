# Environment secrets — never commit
.env

# Vercel deployment metadata
.vercel

# SQLite database files (use MySQL in production)
data/*.db
data/*.sqlite
*.db
*.sqlite

# Encrypted database backups and backup manifests
*.mchms
*.mchms.sha256

# Uploaded files (user content, not source code)
uploads/*
!uploads/.gitkeep

# OS & editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json

# PHP Composer vendor (if added later)
vendor/

# Local bat files that expose tunnel/local credentials
run_nepal_hospital.bat
setup_mysql_tunnel.bat

# Development scratch & audit tooling (not production code)
scratch/
*.bak

# original uncompressed image backups (kept locally only)
assets/images/_originals/
